{
  "plugins": {
    "@textlint/markdown": {
      "extensions": [".md", ".markdown"]
    }
  },
  "rules": {
    "preset-zh-technical-writing": {
      "zhRuleSeries": true,
      "terminology": true,
      "noInvalidControlCharacter": true
    },
    "terminology": {
      "defaultTerms": true,
      "skip": ["Blockquote", "CodeBlock", "Code"],
      "terms": [
        ["Javascript", "JavaScript"],
        ["Typescript", "TypeScript"],
        ["Github", "GitHub"],
        ["Gitlab", "GitLab"],
        ["NPM", "npm"],
        ["NodeJS", "Node.js"],
        ["Postgre[ -]?SQL", "PostgreSQL"],
        ["Mongo[ -]?DB", "MongoDB"],
        ["Vs[Cc]ode", "VS Code"],
        ["Mac[ -]?OS", "macOS"],
        ["IOS", "iOS"],
        ["Html5", "HTML5"],
        ["Css3", "CSS3"],
        ["[Kk]8[sS]", "Kubernetes"],
        ["front[- ]end(\\w*)", "frontend$1"],
        ["back[- ]end(\\w*)", "backend$1"],
        ["hot[- ]key", "hotkey"],
        ["\\brepo\\b", "repository"],
        ["\\bapi\\b", "API"]
      ]
    },
    "sentence-length": {
      "max": 100,
      "skipPatterns": ["/^\\s*$/"]
    }
  },
  "filters": {},
  "overrides": [
    {
      "files": ["**/*.md"],
      "rules": {}
    }
  ]
}