{
  "name": "zh-blog-lint",
  "version": "1.0.0",
  "description": "中文技术博客写作规范检查工具",
  "scripts": {
    "lint": "markdownlint '**/*.md' && textlint '**/*.md'",
    "lint:fix": "markdownlint --fix '**/*.md' && textlint --fix '**/*.md'"
  },
  "devDependencies": {
    "markdownlint-cli": "^0.39.0",
    "textlint": "^14.0.0",
    "textlint-rule-preset-zh-technical-writing": "^4.0.0",
    "textlint-plugin-markdown": "^2.0.0"
  }
}
