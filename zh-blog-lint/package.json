{
  "name": "zh-blog-lint",
  "version": "1.0.0",
  "scripts": {
    "lint": "textlint \"**/*.md\" --ignore node_modules && markdownlint-cli2 --config .markdownlint.json \"**/*.md\"",
    "lint:fix": "textlint --fix \"**/*.md\" --ignore node_modules && markdownlint-cli2 --config .markdownlint.json --fix \"**/*.md\"",
    "lint:text": "textlint \"**/*.md\" --ignore node_modules",
    "lint:md": "markdownlint-cli2 --config .markdownlint.json \"**/*.md\"",
    "lint:vale": "vale ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "中文技术博客审核工具包：textlint + markdownlint + Vale 配置",
  "dependencies": {
    "@textlint/textlint-plugin-markdown": "^15.8.0",
    "textlint": "^15.8.0",
    "textlint-rule-preset-zh-technical-writing": "^0.0.3",
    "textlint-rule-sentence-length": "^5.2.1",
    "textlint-rule-terminology-zh": "^0.0.1"
  }
}
